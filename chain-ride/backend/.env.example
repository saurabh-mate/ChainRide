# ChainRide Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=5000
MONGO_URI=mongodb://localhost:27017/chainride

# SECURITY: Use a cryptographically random string of at least 32 characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d

# Google Maps API key (server-side only)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend origin (for CORS allowlist in production)
# FRONTEND_URL=https://yourdomain.com

NODE_ENV=development
